{
  "name": "pocket-tools",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Pocket Tools — 모바일 올인원 도구 PWA (URL 정리 · 이미지 압축 · 사진 비율 · PDF↔이미지 · EXIF 제거·모자이크 · 워터마크 · QR), 100% 브라우저 내부 처리",
  "scripts": {
    "dev": "vite",
    "pdfjs-assets": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-licenses.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "node e2e/e2e.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsqr": "^1.4.0",
    "piexifjs": "^1.0.6",
    "playwright": "1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
